<?xml version="1.0" encoding="utf-8"?>
<!--
  PopReel reel mark from the Stitch "PopReel App Icon" (48-unit viewBox), scaled 1.45x into the
  108dp adaptive canvas so its 21.5-unit radius stays inside the 33dp-radius safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.45"
        android:scaleY="1.45"
        android:translateX="19.2"
        android:translateY="19.2">
        <!-- Reel body -->
        <path
            android:fillColor="#141722"
            android:pathData="M4,24a20,20 0,1 0,40 0a20,20 0,1 0,-40 0z" />
        <!-- Gradient ring -->
        <path
            android:pathData="M4,24a20,20 0,1 0,40 0a20,20 0,1 0,-40 0z"
            android:strokeWidth="3">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:endX="42"
                    android:endY="42"
                    android:startX="6"
                    android:startY="6"
                    android:type="linear">
                    <item android:color="#FFFFB830" android:offset="0" />
                    <item android:color="#FFFF4757" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Gradient hub -->
        <path android:pathData="M16,24a8,8 0,1 0,16 0a8,8 0,1 0,-16 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="42"
                    android:endY="42"
                    android:startX="6"
                    android:startY="6"
                    android:type="linear">
                    <item android:color="#FFFFB830" android:offset="0" />
                    <item android:color="#FFFF4757" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Sprocket holes -->
        <path
            android:fillColor="#FFB830"
            android:pathData="M21.5,11a2.5,2.5 0,1 0,5 0a2.5,2.5 0,1 0,-5 0zM8.5,24a2.5,2.5 0,1 0,5 0a2.5,2.5 0,1 0,-5 0z" />
        <path
            android:fillColor="#FF4757"
            android:pathData="M21.5,37a2.5,2.5 0,1 0,5 0a2.5,2.5 0,1 0,-5 0zM34.5,24a2.5,2.5 0,1 0,5 0a2.5,2.5 0,1 0,-5 0z" />
        <!-- Play glyph -->
        <path
            android:fillColor="#0B0E17"
            android:pathData="M22,20L28,24L22,28z" />
        <!-- Sparkle -->
        <path
            android:pathData="M34,14L37,11M38,16L42,14"
            android:strokeColor="#FFB830"
            android:strokeLineCap="round"
            android:strokeWidth="2.5" />
    </group>
</vector>
